              "raw": "{{baseUrl}}/api/manufacturers",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "manufacturers" ]
            }
          }
        },
        {
          "name": "Create Beer Punk IPA (→ createdBeerId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has numeric id', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.collectionVariables.set('createdBeerId', json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUser}}", "type": "string" },
                { "key": "password", "value": "{{adminPass}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Punk IPA\",\n  \"abv\": 5.6,\n  \"type\": \"IPA\",\n  \"description\": \"Fruity and aggressively hopped post-modern classic\",\n  \"manufacturerId\": {{createdManufacturerId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/beers",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "beers" ]
            }
          }
        },
        {
          "name": "Create Beer Pale Ale",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has numeric id', () => {",
                  "    pm.expect(pm.response.json().id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUser}}", "type": "string" },
                { "key": "password", "value": "{{adminPass}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pale Ale\",\n  \"abv\": 5.6,\n  \"type\": \"ALE\",\n  \"description\": \"Light and refreshing American pale ale\",\n  \"manufacturerId\": {{createdManufacturerId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/beers",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "beers" ]
            }
          }
        }
      ]
