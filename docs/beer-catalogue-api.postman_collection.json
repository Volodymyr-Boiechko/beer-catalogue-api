    {
      "name": "4 — Conflict (409)",
      "description": "Posting a manufacturer whose (name, country) pair already exists must return 409 with a specific message.",
      "item": [
        {
          "name": "POST Brewdog/Scotland again → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Message contains already exists', () => {",
                  "    pm.expect(pm.response.json().message).to.include('already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUser}}", "type": "string" },
